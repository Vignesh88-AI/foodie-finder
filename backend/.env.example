PORT=5000
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Your Vercel frontend URL — used to restrict CORS
FRONTEND_URL=https://your-app.vercel.app

# Spoonacular API — free 150 points/day at spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_key

# Groq AI for chatbot — free at console.groq.com (no card)
GROQ_API_KEY=your_groq_api_key

# USDA FoodData — 100% free, DEMO_KEY works out of the box
USDA_API_KEY=DEMO_KEY
