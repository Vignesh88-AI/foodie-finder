PORT=5000
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Spoonacular API — free 150 points/day — spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_key

# Groq AI for chatbot — free at console.groq.com (no card needed)
GROQ_API_KEY=your_groq_api_key

# USDA FoodData Central — 100% free, no signup needed
# DEMO_KEY works out of the box (1000 req/hr, 5000/day)
# For higher limits get a free key at fdc.nal.usda.gov/api-guide
USDA_API_KEY=DEMO_KEY
